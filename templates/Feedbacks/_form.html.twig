{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    <div class="row">
        <div class="col-md-6">{{ include('_ui/_field.html.twig', {field: form.name, placeholder: 'Your name'}) }}</div>
        <div class="col-md-6">{{ include('_ui/_field.html.twig', {field: form.email, placeholder: 'name@example.com'}) }}</div>
    </div>
    {{ include('_ui/_field.html.twig', {field: form.Feedbacks, placeholder: 'Share your experience…', rows: 5}) }}
    {{ include('_ui/_field.html.twig', {field: form.sentAt}) }}
    <div class="d-flex justify-content-end gap-2 mt-2">
        <a href="{{ path('Feedbacks_index') }}" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="fas fa-check me-2"></i>{{ button_label|default('Save feedback') }}</button>
    </div>
{{ form_end(form) }}
