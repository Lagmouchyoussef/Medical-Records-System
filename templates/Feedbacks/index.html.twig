{% extends 'base.html.twig' %}

{% block title %}Feedbacks{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h1>Feedbacks</h1>
        <p>{{ Feedbackss|length }} received</p>
    </div>
    <a href="{{ path('Feedbacks_new') }}" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New feedback</a>
</div>

<div class="panel">
    {% if Feedbackss|length %}
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr><th>From</th><th>Feedback</th><th>Date</th><th class="actions"><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
            {% for feedback in Feedbackss %}
                <tr>
                    <td>
                        <div class="person">
                            <div class="avatar">{{ feedback.name|first|upper }}</div>
                            <div>
                                <div class="name">{{ feedback.name }}</div>
                                <a class="sub" href="mailto:{{ feedback.email }}">{{ feedback.email }}</a>
                            </div>
                        </div>
                    </td>
                    <td><div class="truncate" title="{{ feedback.Feedbacks }}">{{ feedback.Feedbacks }}</div></td>
                    <td><span class="tag">{{ feedback.sentAt ? feedback.sentAt|date('d M Y, H:i') : 'N/A' }}</span></td>
                    <td class="actions">
                        <a href="{{ path('Feedbacks_edit', {'id': feedback.id}) }}" class="btn btn-ghost btn-icon" title="Edit" aria-label="Edit feedback from {{ feedback.name }}"><i class="fas fa-pen"></i></a>
                        {{ include('Feedbacks/_delete_form.html.twig', {'feedback': feedback}) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="empty">
        <div class="icon"><i class="fas fa-star"></i></div>
        <h3>No feedback yet</h3>
        <p>Patient opinions will appear here.</p>
        <a href="{{ path('Feedbacks_new') }}" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New feedback</a>
    </div>
    {% endif %}
</div>
{% endblock %}
