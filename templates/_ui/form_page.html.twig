{% extends 'base.html.twig' %}
{# Shared layout for create/edit pages.
   Blocks: heading, subtitle, form_content, actions (extra buttons next to Back) #}
{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <a href="{{ back_url }}" class="breadcrumb-link"><i class="fas fa-arrow-left"></i>{{ back_label }}</a>
        <div class="page-head">
            <div>
                <h1>{% block heading %}{% endblock %}</h1>
                <p>{% block subtitle %}{% endblock %}</p>
            </div>
        </div>
        <div class="panel">
            <div class="panel-body">{% block form_content %}{% endblock %}</div>
            {% block actions %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
