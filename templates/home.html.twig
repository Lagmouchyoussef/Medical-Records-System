{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js" integrity="sha384-bs/nf9FbdNouRbMiFcrcZfLXYPKiPaGVGplVbv7dLGECccEXDW+S3zjqSKR5ZEaD" crossorigin="anonymous"></script>
{% endblock %}

{% block body %}
{% set t = stats.totals %}
{% set k = stats.kpis %}

<div class="page-head">
    <div>
        <h1>Dashboard</h1>
        <p>{{ 'now'|date('l, F j, Y') }} · overview of your practice</p>
    </div>
    <form action="{{ path('patient_index') }}" method="get" class="dash-search" role="search">
        <i class="fas fa-magnifying-glass"></i>
        <input type="search" name="q" class="form-control" placeholder="Search a patient, illness or doctor…" aria-label="Search patients">
    </form>
</div>

{# ---------- Quick actions ---------- #}
<section class="quick-grid" aria-label="Quick actions">
    <a href="{{ path('patient_new') }}" class="quick-tile"><span class="qi"><i class="fas fa-user-plus"></i></span><span><strong>Add patient</strong><small>Register a new patient</small></span></a>
    <a href="{{ path('patient_index') }}" class="quick-tile"><span class="qi"><i class="fas fa-users"></i></span><span><strong>All patients</strong><small>Browse and edit records</small></span></a>
    <a href="{{ path('message_new') }}" class="quick-tile"><span class="qi"><i class="fas fa-envelope"></i></span><span><strong>New message</strong><small>Write to the inbox</small></span></a>
    <a href="{{ path('Feedbacks_new') }}" class="quick-tile"><span class="qi"><i class="fas fa-star"></i></span><span><strong>New feedback</strong><small>Record patient opinion</small></span></a>
    <a href="{{ path('contact') }}" class="quick-tile"><span class="qi"><i class="fas fa-headset"></i></span><span><strong>Contact page</strong><small>Public contact form</small></span></a>
</section>

{# ---------- KPIs ---------- #}
<section class="row g-3 mb-4" aria-label="Key figures">
    <div class="col-6 col-lg-3">
        <a href="{{ path('patient_index') }}" class="panel kpi">
            <div class="kpi-icon"><i class="fas fa-user-injured"></i></div>
            <div class="kpi-value">{{ t.patients }}</div>
            <div class="kpi-label">Patients</div>
            <div class="kpi-note">{{ t.doctors }} doctor{{ t.doctors == 1 ? '' : 's' }} on duty</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="{{ path('patient_index') }}" class="panel kpi">
            <div class="kpi-icon blue"><i class="far fa-calendar-check"></i></div>
            <div class="kpi-value">{{ k.visitsThisWeek }}</div>
            <div class="kpi-label">Visits in the next 7 days</div>
            <div class="kpi-note">{{ k.upcomingVisits }} upcoming in total</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="{{ path('message_index') }}" class="panel kpi">
            <div class="kpi-icon amber"><i class="fas fa-envelope"></i></div>
            <div class="kpi-value">{{ k.messagesThisMonth }}</div>
            <div class="kpi-label">Messages this month</div>
            <div class="kpi-note">{{ t.messages }} received overall</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="{{ path('Feedbacks_index') }}" class="panel kpi">
            <div class="kpi-icon rose"><i class="fas fa-star"></i></div>
            <div class="kpi-value">{{ t.feedbacks }}</div>
            <div class="kpi-label">Feedbacks</div>
            <div class="kpi-note">Patient opinions collected</div>
        </a>
    </div>
</section>

{# ---------- Charts ---------- #}
<section class="row g-3 mb-4" aria-label="Charts">
    <div class="col-lg-8">
        <div class="panel h-100">
            <div class="panel-head"><h2>Activity over time</h2><span class="text-muted small">Last 5 months + next month</span></div>
            <div class="panel-body"><div class="chart-box"><canvas id="chart-activity" role="img" aria-label="Line chart of visits, messages and feedbacks per month"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel h-100">
            <div class="panel-head"><h2>Visit status</h2></div>
            <div class="panel-body"><div class="chart-box"><canvas id="chart-status" role="img" aria-label="Doughnut chart of upcoming, completed and unscheduled visits"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-head"><h2>Most common illnesses</h2></div>
            <div class="panel-body"><div class="chart-box"><canvas id="chart-illness" role="img" aria-label="Doughnut chart of patients by illness"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-head"><h2>Patients per doctor</h2></div>
            <div class="panel-body"><div class="chart-box"><canvas id="chart-doctors" role="img" aria-label="Bar chart of patients per doctor"></canvas></div></div>
        </div>
    </div>
</section>

{# ---------- Lists ---------- #}
<section class="row g-3" aria-label="Upcoming visits and recent messages">
    <div class="col-lg-7">
        <div class="panel h-100">
            <div class="panel-head"><h2>Next visits</h2><a href="{{ path('patient_index') }}" class="small fw-semibold">View all</a></div>
            {% if stats.upcoming|length %}
                <ul class="mini-list">
                {% for v in stats.upcoming %}
                    <li>
                        <div class="date-chip"><span>{{ v.date|date('M') }}</span><strong>{{ v.date|date('d') }}</strong></div>
                        <div class="grow">
                            <div class="name">{{ v.patient.name }}</div>
                            <div class="sub">{{ v.patient.illness }} · {{ v.patient.assignedDoctor }}</div>
                        </div>
                        <span class="tag tag-blue"><i class="far fa-clock"></i>{{ v.date|date('H:i') }}</span>
                        <a href="{{ path('patient_edit', {'id': v.patient.id}) }}" class="btn btn-ghost btn-icon" title="Edit" aria-label="Edit {{ v.patient.name }}"><i class="fas fa-pen"></i></a>
                    </li>
                {% endfor %}
                </ul>
            {% else %}
                <div class="empty"><div class="icon"><i class="far fa-calendar"></i></div><h3>No upcoming visits</h3><p>Schedule a visit when you add a patient.</p><a href="{{ path('patient_new') }}" class="btn btn-primary"><i class="fas fa-plus"></i>Add patient</a></div>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-5">
        <div class="panel h-100">
            <div class="panel-head"><h2>Recent messages</h2><a href="{{ path('message_index') }}" class="small fw-semibold">View all</a></div>
            {% if stats.recentMessages|length %}
                <ul class="mini-list">
                {% for m in stats.recentMessages %}
                    <li>
                        <div class="avatar">{{ m.name|first|upper }}</div>
                        <div class="grow">
                            <div class="name">{{ m.name }}</div>
                            <div class="sub truncate">{{ m.message }}</div>
                        </div>
                        <a href="{{ path('message_show', {'id': m.id}) }}" class="btn btn-ghost btn-icon" title="Open" aria-label="Open message from {{ m.name }}"><i class="fas fa-eye"></i></a>
                    </li>
                {% endfor %}
                </ul>
            {% else %}
                <div class="empty"><div class="icon"><i class="fas fa-envelope"></i></div><h3>No messages yet</h3><p>New messages will show up here.</p></div>
            {% endif %}
        </div>
    </div>
</section>

<div id="dash-data" data-charts="{{ stats.charts|json_encode|e('html_attr') }}" hidden></div>
<script>
(function () {
    if (typeof Chart === 'undefined') { return; }
    var d = JSON.parse(document.getElementById('dash-data').dataset.charts);
    var C = { teal: '#0f766e', mint: '#14b8a6', blue: '#2563eb', amber: '#d97706', rose: '#e11d48', slate: '#94a3b8', violet: '#7c3aed' };
    var palette = [C.teal, C.blue, C.amber, C.rose, C.violet, C.slate];
    var grid = '#e2e8f0', text = '#64748b';

    Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
    Chart.defaults.color = text;
    Chart.defaults.maintainAspectRatio = false;
    Chart.defaults.plugins.legend.labels.usePointStyle = true;
    Chart.defaults.plugins.legend.labels.boxWidth = 8;

    function empty(id) {
        var box = document.getElementById(id).parentNode;
        box.innerHTML = '<div class="chart-empty"><i class="fas fa-chart-simple"></i><span>No data yet</span></div>';
    }
    function sum(a) { return a.reduce(function (x, y) { return x + y; }, 0); }
    var ints = { beginAtZero: true, ticks: { precision: 0 }, grid: { color: grid } };

    // Activity (line)
    new Chart(document.getElementById('chart-activity'), {
        type: 'line',
        data: { labels: d.months, datasets: [
            { label: 'Visits', data: d.visits, borderColor: C.teal, backgroundColor: 'rgba(15,118,110,.12)', fill: true, tension: .35 },
            { label: 'Messages', data: d.messages, borderColor: C.blue, backgroundColor: C.blue, tension: .35 },
            { label: 'Feedbacks', data: d.feedbacks, borderColor: C.amber, backgroundColor: C.amber, tension: .35 }
        ]},
        options: { interaction: { mode: 'index', intersect: false }, elements: { point: { radius: 3, hoverRadius: 5 }, line: { borderWidth: 2.5 } },
            scales: { y: ints, x: { grid: { display: false } } }, plugins: { legend: { position: 'bottom' } } }
    });

    // Visit status (doughnut)
    if (sum(d.visitStatus.values) === 0) { empty('chart-status'); } else {
        new Chart(document.getElementById('chart-status'), {
            type: 'doughnut',
            data: { labels: d.visitStatus.labels, datasets: [{ data: d.visitStatus.values, backgroundColor: [C.teal, C.slate, C.amber], borderWidth: 0 }] },
            options: { cutout: '68%', plugins: { legend: { position: 'bottom' } } }
        });
    }

    // Illnesses (doughnut)
    if (sum(d.illnessValues) === 0) { empty('chart-illness'); } else {
        new Chart(document.getElementById('chart-illness'), {
            type: 'doughnut',
            data: { labels: d.illnessLabels, datasets: [{ data: d.illnessValues, backgroundColor: palette, borderWidth: 0 }] },
            options: { cutout: '60%', plugins: { legend: { position: 'right' } } }
        });
    }

    // Doctors (horizontal bar)
    if (sum(d.doctorValues) === 0) { empty('chart-doctors'); } else {
        new Chart(document.getElementById('chart-doctors'), {
            type: 'bar',
            data: { labels: d.doctorLabels, datasets: [{ label: 'Patients', data: d.doctorValues, backgroundColor: C.teal, borderRadius: 6, maxBarThickness: 26 }] },
            options: { indexAxis: 'y', scales: { x: ints, y: { grid: { display: false } } }, plugins: { legend: { display: false } } }
        });
    }
})();
</script>
{% endblock %}
