{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h1>Contact us</h1>
        <p>Send us a message and we will get back to you as soon as possible.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4 order-lg-2">
        <div class="panel panel-body">
            <div class="contact-item">
                <div class="icon"><i class="fas fa-phone"></i></div>
                <div><div class="label">Phone</div><div class="value">+212 6XX XXX XXX</div></div>
            </div>
            <div class="contact-item">
                <div class="icon"><i class="fas fa-envelope"></i></div>
                <div><div class="label">Email</div><div class="value">contact@medifolio.example</div></div>
            </div>
            <div class="contact-item mb-0">
                <div class="icon"><i class="fas fa-lock"></i></div>
                <div><div class="label">Privacy</div><div class="value">Your information stays confidential.</div></div>
            </div>
        </div>
    </div>
    <div class="col-lg-8 order-lg-1">
        <div class="panel"><div class="panel-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="row">
                    <div class="col-md-6">{{ include('_ui/_field.html.twig', {field: form.name, placeholder: 'Your full name'}) }}</div>
                    <div class="col-md-6">{{ include('_ui/_field.html.twig', {field: form.email, placeholder: 'name@example.com'}) }}</div>
                </div>
                {{ include('_ui/_field.html.twig', {field: form.message, placeholder: 'How can we help?', rows: 6}) }}
                <div class="d-flex justify-content-end mt-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane me-2"></i>Send message</button>
                </div>
            {{ form_end(form) }}
        </div></div>
    </div>
</div>
{% endblock %}
