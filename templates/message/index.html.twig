{% extends 'base.html.twig' %}

{% block title %}Messages{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h1>Messages</h1>
        <p>{{ messages|length }} received</p>
    </div>
    <a href="{{ path('message_new') }}" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New message</a>
</div>

<div class="panel">
    {% if messages|length %}
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr><th>From</th><th>Message</th><th>Date</th><th class="actions"><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
            {% for message in messages %}
                <tr>
                    <td>
                        <div class="person">
                            <div class="avatar">{{ message.name|first|upper }}</div>
                            <div>
                                <div class="name">{{ message.name }}</div>
                                <a class="sub" href="mailto:{{ message.email }}">{{ message.email }}</a>
                            </div>
                        </div>
                    </td>
                    <td><div class="truncate" title="{{ message.message }}">{{ message.message }}</div></td>
                    <td><span class="tag">{{ message.sentAt ? message.sentAt|date('d M Y, H:i') : 'N/A' }}</span></td>
                    <td class="actions">
                        <a href="{{ path('message_show', {'id': message.id}) }}" class="btn btn-ghost btn-icon" title="View" aria-label="View message from {{ message.name }}"><i class="fas fa-eye"></i></a>
                        <a href="{{ path('message_edit', {'id': message.id}) }}" class="btn btn-ghost btn-icon" title="Edit" aria-label="Edit message from {{ message.name }}"><i class="fas fa-pen"></i></a>
                        {{ include('message/_delete_form.html.twig', {'message': message}) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="empty">
        <div class="icon"><i class="fas fa-envelope"></i></div>
        <h3>No messages yet</h3>
        <p>Messages sent from the contact page will appear here.</p>
        <a href="{{ path('message_new') }}" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New message</a>
    </div>
    {% endif %}
</div>
{% endblock %}
