{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ include('_ui/_field.html.twig', {field: form.name, placeholder: 'e.g. Sara Benali'}) }}
    {{ include('_ui/_field.html.twig', {field: form.illness, placeholder: 'e.g. Seasonal flu'}) }}
    <div class="row">
        <div class="col-md-6">{{ include('_ui/_field.html.twig', {field: form.assignedDoctor, placeholder: 'e.g. Dr. Amrani'}) }}</div>
        <div class="col-md-6">{{ include('_ui/_field.html.twig', {field: form.visitDate}) }}</div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-2">
        <a href="{{ path('patient_index') }}" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="fas fa-check me-2"></i>{{ button_label|default('Save patient') }}</button>
    </div>
{{ form_end(form) }}
