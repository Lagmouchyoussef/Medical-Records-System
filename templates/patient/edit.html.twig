{% extends '_ui/form_page.html.twig' %}
{% set back_url = path('patient_index') %}
{% set back_label = 'Patients' %}
{% block title %}Edit patient{% endblock %}
{% block heading %}Edit {{ patient.name }}{% endblock %}
{% block subtitle %}Update the patient's information.{% endblock %}
{% block form_content %}{{ include('patient/_form.html.twig', {'button_label': 'Save changes'}) }}{% endblock %}
{% block actions %}
<div class="panel-foot d-flex justify-content-between align-items-center">
    <span class="text-muted small">Danger zone</span>
    {{ include('patient/_delete_form.html.twig', {'patient': patient, 'label': 'Delete patient'}) }}
</div>
{% endblock %}
