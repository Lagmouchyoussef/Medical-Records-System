{% extends 'base.html.twig' %}

{% block title %}Patients{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h1>Patients</h1>
        <p>{{ patients|length }} {{ query|default('') ? 'found' : 'registered' }} · {{ patients|filter(p => p.visitDate)|length }} with a scheduled visit</p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <form method="get" class="dash-search" role="search">
            <i class="fas fa-magnifying-glass"></i>
            <input type="search" name="q" value="{{ query|default('') }}" class="form-control" placeholder="Search patients…" aria-label="Search patients">
        </form>
        <a href="{{ path('patient_new') }}" class="btn btn-primary"><i class="fas fa-plus"></i>New patient</a>
    </div>
</div>

<div class="panel">
    {% if patients|length %}
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr><th>Patient</th><th>Illness</th><th>Doctor</th><th>Next visit</th><th class="actions"><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
            {% for patient in patients %}
                <tr>
                    <td>
                        <div class="person">
                            <div class="avatar">{{ patient.name|first|upper }}</div>
                            <div><div class="name">{{ patient.name }}</div><div class="sub">#{{ patient.id }}</div></div>
                        </div>
                    </td>
                    <td><span class="tag tag-red">{{ patient.illness }}</span></td>
                    <td><span class="doctor"><i class="fas fa-user-doctor"></i>{{ patient.assignedDoctor }}</span></td>
                    <td>
                        {% if patient.visitDate %}
                            <span class="tag tag-blue"><i class="far fa-calendar"></i>{{ patient.visitDate|date('d M Y, H:i') }}</span>
                        {% else %}
                            <span class="tag">Not scheduled</span>
                        {% endif %}
                    </td>
                    <td class="actions">
                        <a href="{{ path('patient_edit', {'id': patient.id}) }}" class="btn btn-ghost btn-icon" title="Edit" aria-label="Edit {{ patient.name }}"><i class="fas fa-pen"></i></a>
                        {{ include('patient/_delete_form.html.twig', {'patient': patient}) }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="empty">
        <div class="icon"><i class="fas fa-user-injured"></i></div>
        {% if query|default('') %}
            <h3>No patient matches "{{ query }}"</h3>
            <p>Try another name, illness or doctor.</p>
            <a href="{{ path('patient_index') }}" class="btn btn-ghost">Clear search</a>
        {% else %}
            <h3>No patients yet</h3>
            <p>Add your first patient to get started.</p>
            <a href="{{ path('patient_new') }}" class="btn btn-primary"><i class="fas fa-plus"></i>New patient</a>
        {% endif %}
    </div>
    {% endif %}
</div>
{% endblock %}
